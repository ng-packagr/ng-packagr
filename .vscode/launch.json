{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch current file w/ ts-node",
      "protocol": "inspector",
      "args": ["${relativeFile}"],
      "cwd": "${workspaceRoot}",
      "runtimeArgs": ["-r", "ts-node/register"],
      "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Samples (all)",
      "program": "${workspaceRoot}/integration/samples.dev.js"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Sample: APF",
      "program": "${workspaceRoot}/integration/samples.dev.js",
      "args": ["apf"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Sample: core",
      "program": "${workspaceRoot}/integration/samples.dev.js",
      "args": ["core"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Sample: custom",
      "program": "${workspaceRoot}/integration/samples.dev.js",
      "args": ["custom"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Sample: scss-paths",
      "program": "${workspaceRoot}/integration/samples.dev.js",
      "args": ["scss-paths"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Sample: embed-assets",
      "program": "${workspaceRoot}/integration/samples.dev.js",
      "args": ["embed-assets"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Sample: issue-852",
      "program": "${workspaceRoot}/integration/samples.dev.js",
      "args": ["issue-852"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Sample: externals",
      "program": "${workspaceRoot}/integration/samples.dev.js",
      "args": ["externals"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Sample: material",
      "program": "${workspaceRoot}/integration/samples.dev.js",
      "args": ["material"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Sample: package-js",
      "program": "${workspaceRoot}/integration/samples/package-js/build.dev.js"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Sample: same-name",
      "program": "${workspaceRoot}/integration/samples.dev.js",
      "args": ["same-name"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Sample: secondary",
      "program": "${workspaceRoot}/integration/samples.dev.js",
      "args": ["secondary"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Sample: typings",
      "program": "${workspaceRoot}/integration/samples.dev.js",
      "args": ["typings"]
    }
  ],
  "compounds": []
}
